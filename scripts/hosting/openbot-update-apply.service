# boat stop and resume work like a reboot. This moves a staged release into place before OpenBot
# starts, so an update never stops work in progress. A failure here does not stop OpenBot: it starts
# the release that is in place.
[Unit]
Description=Apply a staged OpenBot update
Before=openbot.service

[Service]
Type=oneshot
ExecStart=/opt/OpenBot/hosted/openbot-hosted-update apply
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
